{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workorch.dev/schemas/lsp-bridge-prd-evidence-v1.json",
  "title": "LSPBridgePRDEvidenceReport",
  "description": "输入结构合同；通过不代表 producer 已可信或 PRD 已验收。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceId", "runId", "startupIdentity", "deliveryCommit", "serviceSourceIdentity", "producerCoverage", "requirements", "artifacts"],
  "properties": {
    "schemaVersion": {"const": "lsp-bridge.prd-evidence/v1"},
    "workspaceId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "startupIdentity": {"$ref": "#/$defs/hash"},
    "deliveryCommit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "serviceSourceIdentity": {"$ref": "#/$defs/hash"},
    "producerCoverage": {"enum": ["unknown", "verified"]},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^LSP-(0[1-9]|1[0-9]|20)$"},
        "status": {"const": "passed"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["workspaceId", "runId", "startupIdentity", "deliveryCommit", "serviceSourceIdentity", "checkId", "command", "exitCode", "result", "execution", "artifactRefs", "facts"],
      "properties": {
        "workspaceId": {"type": "string", "minLength": 1},
        "runId": {"type": "string", "minLength": 1},
        "startupIdentity": {"$ref": "#/$defs/hash"},
        "deliveryCommit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "serviceSourceIdentity": {"$ref": "#/$defs/hash"},
        "checkId": {"type": "string", "pattern": "^LSP-(0[1-9]|1[0-9]|20)$"},
        "command": {"type": "string", "minLength": 1},
        "exitCode": {"type": "integer", "const": 0},
        "result": {"const": "passed"},
        "execution": {"enum": ["real", "fixture"]},
        "artifactRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "facts": {"type": "object"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["workspaceId", "runId", "startupIdentity", "deliveryCommit", "serviceSourceIdentity", "ref", "kind", "path", "sha256"],
      "properties": {
        "workspaceId": {"type": "string", "minLength": 1},
        "runId": {"type": "string", "minLength": 1},
        "startupIdentity": {"$ref": "#/$defs/hash"},
        "deliveryCommit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "serviceSourceIdentity": {"$ref": "#/$defs/hash"},
        "ref": {"type": "string", "minLength": 1},
        "kind": {"enum": ["command_output", "test_report", "benchmark_report", "source_snapshot", "documentation_index"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "facts": {
      "type": "object",
      "description": "具体字段由校验器按 requirement id 精确验证，Schema 不将任意 facts 视为通过。"
    }
  }
}
